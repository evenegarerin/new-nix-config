#!/bin/sh
# elephant's launch_prefix, see config/elephant/elephant.toml.
#
# Elephant activates an app by running
#
#   sh -c "<launch_prefix> <Exec line of the .desktop file> <args>"
#
# so the app's own command arrives here in "$@". Elephant is a daemon and the
# prefix is a single global setting read once at startup, so there is no
# per-invocation way to tell it where the app should go. The launcher keybinds
# in hyprland.d/launcher.lua leave the mode behind in a file instead.

mode=$(cat "$XDG_RUNTIME_DIR/launcher-mode" 2>/dev/null || echo normal)

if [ "$mode" = new-workspace ]; then
    # Hand the command back to Hyprland so it spawns the app itself and can
    # attach an exec rule to it. The rule tags the window; the window.open
    # handler in launcher.lua matches that tag and hands out the workspace.
    exec hyprctl eval "hl.dispatch(hl.dsp.exec_cmd([[$*]], { tag = 'launch-into-new-workspace' }))"
else
    exec "$@"
fi
